# Local Development Environment
# Requests to /api are proxied by Vite dev server to VITE_BACKEND_TARGET
VITE_API_BASE_URL=/api

# Local Backend target URL:
# - IIS Express default: https://localhost:44332
# - Kestrel HTTPS default: https://localhost:7145
# - Kestrel HTTP default: http://localhost:5222
VITE_BACKEND_TARGET=https://localhost:44332
